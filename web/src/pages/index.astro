---
// comprobación de la fase 1: la web llega a la api por la red de docker
const api = process.env.API_URL ?? 'http://localhost:8000';
const salud = await fetch(`${api}/health`).then(r => r.json()).catch(() => ({ ok: false }));
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Run-AI</title>
  </head>
  <body>
    <h1>Run-AI</h1>
    <p>api: {salud.ok ? 'ok' : 'sin conexión'}</p>
  </body>
</html>
