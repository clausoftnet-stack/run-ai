# Copia a .env y rellena. El .env no va a git. Todo sale del panel de Supabase de tu proyecto.

# --- api y web (Project Settings → Data API / API Keys)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# salta el RLS: solo la api y el cron. Nunca en el navegador ni en el chat
SUPABASE_SECRET_KEY=sb_secret_...

# --- conexión directa a Postgres: importar.py, tests contra la nube, cron
# Project Settings → Database → Connection string → "Session pooler" (la "Direct" es solo IPv6)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- CLI de Supabase: subir migraciones (supabase link / db push) y configurar Auth
SUPABASE_PROJECT_REF=<ref>
SUPABASE_DB_PASSWORD=
# Account (tu avatar) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_...

# --- la web llama a la api por la red interna de docker
API_URL=http://api:8000
